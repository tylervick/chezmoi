[branch]
	sort = -committerdate

[column]
	ui = auto

[commit]
	gpgSign = true

[core]
	autocrlf = input
	editor = vim

# Managed here rather than left as drift from `gh auth login`, which writes these
# on first auth. gh acts as git's credential helper for HTTPS remotes/gists; the
# empty `helper =` first resets any inherited helper before appending gh's. See
# `gh auth setup-git`. Path is hardcoded (Apple Silicon brew prefix) like the rest
# of this config.
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[fetch]
	prune = true
	pruneTags = true
	all = true

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[gpg]
	format = ssh

[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	allowedSignersFile = ~/.config/git/allowed_ssh_signers

[help]
	autocorrect = prompt

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = simple
	followTags = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[rerere]
	enabled = true
	autoupdate = true

[tag]
	gpgSign = false
	sort = version:refname

[user]
	email = {{ .email | quote }}
	name = {{ .name | quote }}
	signingKey = {{ .signing_key | quote }}
